# Database (Render Postgres provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# WhatsApp webhook verification (set same value in Meta Developer Console)
VERIFY_TOKEN=your_secret_verify_token_here

# WhatsApp Cloud API — required for confirmation replies
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Google Gemini — required for delivery note photo extraction
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Optional
BUSINESS_NAME=My Business
DEFAULT_BUSINESS_ID=1
WHATSAPP_API_VERSION=v21.0

# Dashboard login (Sprint 6) — set on Render to protect reports/pages
DASHBOARD_PASSWORD=choose-a-strong-team-password
SESSION_SECRET=long-random-string-at-least-32-characters

# Optional — comma-separated origins for a separate web app (Sprint 7+)
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
