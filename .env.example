# Database (Render Postgres provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# WhatsApp webhook verification (set same value in Meta Developer Console)
VERIFY_TOKEN=your_secret_verify_token_here

# WhatsApp Cloud API — required for confirmation replies
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Optional
BUSINESS_NAME=My Business
DEFAULT_BUSINESS_ID=1
WHATSAPP_API_VERSION=v21.0
